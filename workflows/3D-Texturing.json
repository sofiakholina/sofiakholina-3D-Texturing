е, но аккуратнее)"],"widgets_values_named":{"text":"**Указать полный путь к файлу или имя файла из папки input.** Путь: в проводнике правая кнопка по файлу (в Windows 10 - Shift + правая кнопка) → «Копировать как путь», вставить в поле\n\nЕсли на модели ваша UV - выбрать keep_existing. Если модель без UV - comfy_gpu или xatlas (xatlas дольше, но аккуратнее)"},"color":"#223","bgcolor":"#335"},{"id":86,"type":"MarkdownNote","pos":[680,1130],"size":[530,88],"flags":{},"order":6,"mode":0,"inputs":[],"outputs":[],"title":"Note","properties":{},"widgets_values":["**Модель сохраняется автоматически в output ComfyUI - путь виден в поле folder**\n\n**Свою папку можно выбрать кнопкой Choose folder**"],"widgets_values_named":{"text":"**Модель сохраняется автоматически в output ComfyUI - путь виден в поле folder**\n\n**Свою папку можно выбрать кнопкой Choose folder**"},"color":"#223","bgcolor":"#335"},{"id":87,"type":"CreateCameraInfo","pos":[670,20],"size":[270,60],"flags":{"collapsed":true},"order":12,"mode":2,"inputs":[],"outputs":[],"title":"3D viewer loader (keep muted)","properties":{"Node name for S&R":"CreateCameraInfo","cnr_id":"comfy-core"},"widgets_values":[]}],"links":[[49,1,0,44,4,"IMAGE"],[57,44,0,24,0,"FILE_3D_GLB"],[64,44,1,46,0,"IMAGE"],[66,44,2,47,0,"IMAGE"],[97,44,3,48,1,"TRIMESH"],[102,61,0,44,5,"TRIMESH"],[103,61,1,44,6,"*"],[104,61,2,48,4,"STRING"],[105,61,3,48,7,"STRING"]],"groups":[],"definitions":{"subgraphs":[{"id":"97786133-f94a-4170-b372-4c16235b3670","version":1,"state":{"lastGroupId":5,"lastNodeId":86,"lastLinkId":105,"lastRerouteId":0},"revision":0,"config":{},"name":"UltraTex backend (6/10 views)","inputNode":{"id":-10,"bounding":[300.8622541318029,250.15623852520756,140.54296875,187.99999999999997]},"outputNode":{"id":-20,"bounding":[2498.1268790863887,274.13185935222094,128,128]},"inputs":[{"id":"1d53fed5-8db7-4032-a0d9-d72af329eafb","name":"steps","type":"INT","linkIds":[45,82],"localized_name":"steps","label":"steps","pos":[417.4052228818029,